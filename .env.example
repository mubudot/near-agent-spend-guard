# Testnet only. Never commit private keys. The offline demo and local tests need no environment.
# Key files ({"account_id","public_key","private_key"}) live here; .near/ is git-ignored.
NEAR_KEY_DIR=.near
NEAR_OWNER_ACCOUNT=
NEAR_CONTRACT_ACCOUNT=
NEAR_AGENT_ACCOUNT=
NEAR_AGENT_PUBLIC_KEY=
NEAR_AGENT_PRIVATE_KEY=
# Provisioning only; do not give this full-access key to the demo agent.
NEAR_AGENT_OWNER_PRIVATE_KEY=
# Optional overrides
NEAR_AGENT_KEY_ALLOWANCE=1
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional AI-agent mode (demo/ai-agent.mjs --llm anthropic|openai|auto). The default mock LLM needs none of these.
# LLM_PROVIDER sets the default for --llm: mock | anthropic | openai | auto
LLM_PROVIDER=
# (a) Anthropic Messages API (any compatible endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
AI_AGENT_MODEL=claude-sonnet-5-5
# (b) OpenAI-compatible Chat Completions with tool calling (OpenAI, OpenRouter, DeepSeek, vLLM, Ollama, a gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# max_tokens (default) | max_completion_tokens (newer OpenAI models) | none
OPENAI_MAX_TOKENS_PARAM=
AI_AGENT_MERCHANT=shop.spendguard-b31c91.testnet
# Paid-invoice ledger (each invoice paid at most once): a file path, or memory.
# Default: ~/.near-agent-spend-guard/paid-invoices.json with --submit, in memory otherwise.
AI_AGENT_LEDGER=
